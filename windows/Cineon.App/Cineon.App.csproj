<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 app. The UI is written in C# with no XAML files, so the code also type-checks on a
       Mac: `make win-check` (MacCheck=true skips the steps that need Windows tools). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Cineon.App</RootNamespace>
    <AssemblyName>Cineon</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Cineon.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DisableXbfGeneration>true</DisableXbfGeneration>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);DEBUG_COMMANDS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MacCheck)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <!-- Waits for Cineon.Core.Data.AppPaths from the data-layer port. -->
    <Compile Remove="Services/Updater.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cineon.Core\Cineon.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the Mac app. -->
    <Content Include="..\..\Cineon\Resources\Scripts\*.js" Link="Scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Cineon\Resources\Filters\*.txt" Link="Filters\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
