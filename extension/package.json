{
  "name": "cineon-extension",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Cineon as a browser extension: the same tracking, library, next episode, rescue, shields, downloads and Together as the Mac and Windows apps.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "node scripts/build.mjs && playwright test",
    "package": "node scripts/build.mjs --package"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "0.3.7",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^25.0.1",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "preact": "11.2.0"
  }
}
